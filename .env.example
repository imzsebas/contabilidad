# Copia este archivo como .env.local (en tu PC) y configura lo mismo en Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://finkwolszhtvatkyfiww.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_llave_publica_anon

# Claves de "modo edición" y "saldo inicial" (SIN NEXT_PUBLIC_: solo las ve el servidor)
CLAVE_EDICION=
CLAVE_SALDO=

# Lectura de comprobantes con IA - Google Gemini (SIN NEXT_PUBLIC_: solo la ve el servidor)
# Créala en https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Opcional: modelo a usar (por defecto gemini-3.1-flash-lite)
GEMINI_MODEL=

# Administrar usuarios desde Configuración (SIN NEXT_PUBLIC_: solo la ve el servidor)
# Supabase → Project Settings → API Keys → service_role (secret). NUNCA la pongas en el código.
SUPABASE_SERVICE_ROLE_KEY=
